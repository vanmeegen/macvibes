{
  "name": "macvibes",
  "private": true,
  "version": "0.9.1",
  "license": "MIT",
  "type": "module",
  "bin": {
    "macvibes": "./scripts/cli.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "setup": "bun scripts/setup.ts",
    "doctor": "bun scripts/cli.ts doctor",
    "shutdown": "bun scripts/shutdown.ts",
    "dev:web": "cd apps/web && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "build": "bun run --filter='*' build",
    "lint": "bun run --filter='*' lint && bun run lint:scripts",
    "typecheck": "bun run --filter='*' typecheck && bun run typecheck:scripts",
    "test": "bun run --filter='*' test && bun run test:scripts",
    "lint:scripts": "eslint scripts docs --max-warnings=0",
    "typecheck:scripts": "tsc -p scripts",
    "test:scripts": "bun test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "cd apps/server && bun run db:generate",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "start": "bun run build:web && cd apps/server && bun run start",
    "build:web": "cd apps/web && bun run build",
    "prepare": "husky",
    "baselines": "cd apps/server && bun run baselines",
    "router": "bun apps/server/local-router/run.ts",
    "docs:gen": "bun docs/zustandsmaschinen-gen.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "1.4.5",
    "eslint": "^10.15.0",
    "eslint-plugin-boundaries": "^7.4.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
