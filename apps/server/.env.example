# macvibes-Server — lokale Secrets. Kopieren nach `.env` (wird nicht committet).

# === Modellwahl pro Chat ======================================================
# Das Agenten-Modell wird PRO CHAT im Dropdown gewählt. Katalog = eingebaute
# Modelle + EIGENE Modelle aus ~/macvibes/models.json (JSON-Array von
# {"id","label","slow"}; ids mit "claude"-Präfix sind reserviert, kaputte
# Einträge werden beim Start nur gewarnt). Neue Chats starten mit Claude
# Sonnet 5. Der Credential-Proxy routet pro Request nach dem Modell im Body:
#   claude-*      -> ANTHROPIC_UPSTREAM_URL (Default https://api.anthropic.com)
#   alles andere  -> lokaler Router (LiteLLM-Shim -> Ollama)
#
# Claude-Credentials (für die claude-* Modelle). Der Token verlässt den Host
# nie und landet nie in der Sandbox-VM (die spricht nur mit dem Proxy).
# Bevorzugt: Abo-Token via `claude setup-token`:
# CLAUDE_CODE_OAUTH_TOKEN=
# Alternativ ein API-Key aus der Anthropic Console:
# ANTHROPIC_API_KEY=
#
# Lokaler Router für die Qwen-Modelle (LiteLLM-Shim). macvibes STARTET IHN
# AUTOMATISCH MIT: läuft auf der URL schon einer, wird er benutzt (nie angefasst);
# sonst wird das Startkommando gespawnt und überwacht (Health-Check + Neustart).
# Kommando: MACVIBES_LOCAL_ROUTER_CMD, Default: das mitgelieferte
# apps/server/local-router/run.ts (legt seine venv beim ersten Start selbst an
# unter ~/macvibes/local-router-venv). Shim-Log: ~/macvibes/local-router.log
# Router-Config (Modell-Aliase + Catch-all "*"): existiert ~/macvibes/litellm.yaml,
# nimmt der Router SIE (upgrade-fest — die mitgelieferte litellm_config.yaml
# liegt bei einer Installation in libexec und überlebt kein brew upgrade);
# sonst die mitgelieferte. Expliziter Pfad: MACVIBES_LOCAL_ROUTER_CONFIG.
# MACVIBES_LOCAL_UPSTREAM_URL=http://localhost:8787
# MACVIBES_LOCAL_API_KEY=local
# MACVIBES_LOCAL_ROUTER_CMD=/pfad/zu/run-anthropic-shim.sh
# MACVIBES_LOCAL_ROUTER_CONFIG=/pfad/zu/litellm.yaml
#
# Eigene Anbieter (OpenRouter, OpenAI, jeder andere Endpunkt): `bun run setup`
# fragt EINMAL Anzeigename + Basis-URL + Token + Modell-ID ab und erkennt per
# Mini-Probe selbst, ob der Endpunkt Anthropic- oder OpenAI-Format spricht —
# das Format muss man nicht kennen. Ergebnis:
#   - OpenAI-kompatibel   -> Key hier als <ANZEIGENAME>_API_KEY (z. B.
#     OPENROUTER_API_KEY); der LiteLLM-Router liest ihn per os.environ und
#     übersetzt Anthropic<->OpenAI. Modell-Alias in ~/macvibes/litellm.yaml,
#     Dropdown-Eintrag in ~/macvibes/models.json (beides pflegt das Setup).
#   - Anthropic-kompatibel -> direkte Route in MACVIBES_MODEL_ROUTES (unten).
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
#
# Modell-Routen für Anthropic-/v1/messages-kompatible Endpunkte (matchen VOR
# den Defaults; `bun run setup` trägt erkannte Anbieter hier ein). ACHTUNG: Der
# Proxy hängt den Request-Pfad an upstreamUrl an und schickt Anthropic-Format —
# eine rohe OpenAI-URL funktioniert hier NICHT (die läuft über den Router oben).
# MACVIBES_MODEL_ROUTES=[{"prefix":"my-","upstreamUrl":"https://mein-anthropic-shim.example","apiKey":"sk-..."}]
#
# SSE-Keepalive des Proxys gegen NAT-/Idle-Kappung langer Antworten lokaler
# Modelle ("Connection closed mid-response"). Default 10000 ms; 0 = aus.
# MACVIBES_PROXY_KEEPALIVE_MS=10000
#
# Turn-Timeouts: langsame (lokale) Modelle bekommen automatisch die SLOW-Werte
# (Defaults: Idle 600s / First-Event 180s / Cold-Start 300s), Claude die
# normalen (180s / 8s / 30s). Nur bei Bedarf übersteuern:
# MACVIBES_AGENT_IDLE_TIMEOUT_MS=180000
# MACVIBES_AGENT_SLOW_IDLE_TIMEOUT_MS=600000
# MACVIBES_AGENT_SLOW_FIRST_EVENT_TIMEOUT_MS=180000
# MACVIBES_AGENT_SLOW_COLD_START_TIMEOUT_MS=300000
#
# Prewarm (stiller Config-Warmup beim Projekt-Öffnen) läuft nur für schnelle
# Claude-Modelle; für langsame lokale Modelle wird er automatisch übersprungen.
# Komplett abschalten:
# MACVIBES_DISABLE_PREWARM=1

# Registrierung: jeder kann sich selbst registrieren, muss aber von einem Admin
# freigeschaltet werden. PFLICHT für den ersten Start: der Admin wird per
# Username festgenagelt (wird beim Start befördert + freigeschaltet). Ohne
# diesen Eintrag wird NIEMAND automatisch Admin (H3) — vorher bekam der erste
# Registrant die Rolle, was bei einem im LAN lauschenden Server ein Wettlauf um
# Admin-Rechte war. Ohne Admin kann niemand neue Nutzer freischalten; der
# Server weist beim Start darauf hin. Bitte einen EIGENEN Namen wählen (kein
# vorgegebener Beispielname — der wäre für jeden im Netz erratbar).
MACVIBES_ADMIN_USERNAME=<dein-username>

# Bootstrap-Token (EMPFOHLEN; `bun run setup` erzeugt ihn automatisch): schützt
# den Admin-Namen auf einer FRISCHEN Instanz (Erstinstallation, DB-Reset, neuer
# DB_PATH). Gesetzt ⇒ der Name oben ist reserviert und die Registrierung als
# Admin verlangt GENAU diesen Wert im Feld „Bootstrap-Token"; alle anderen
# Nutzer lassen das Feld leer. Ungesetzt ⇒ wer sich ZUERST mit dem Namen
# registriert, wird Admin — jeder im LAN/VPN kann das sein (der Server warnt
# beim Start, solange kein Admin existiert). Erzeugen z. B.: openssl rand -hex 32
# MACVIBES_ADMIN_BOOTSTRAP_TOKEN=

# Sandbox-Backend: auto (Default) | microsandbox | process
# MACVIBES_SANDBOX=auto

# GitHub-Mirror des Bare-Repos (optional, Phase C). Token in der URL, bleibt
# auf dem Host. Beispiel: https://<user>:<token>@github.com/<user>/macvibes-apps.git
# MACVIBES_GITHUB_REMOTE=
# MACVIBES_MIRROR_INTERVAL_MS=600000
